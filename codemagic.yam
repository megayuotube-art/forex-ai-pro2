workflows:
  flet-android-workflow:
    name: Build Forex AI Pro APK
    max_build_duration: 30
    environment:
      flutter: stable
      xcode: latest
      cocoapods: default
    scripts:
      - name: Set up Python
        script: |
          python3 --version
          python3 -m pip install --upgrade pip
      - name: Install dependencies
        script: |
          pip install "flet[cli]" pandas numpy requests yfinance
      - name: Build Android APK
        script: |
          flet build apk --yes
    artifacts:
      - build/apk/*.apk
